# Porta em que a API roda localmente
PORT=3000

# Origem(ns) autorizada(s) a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Credenciais SMTP usadas para enviar o e-mail do formulário de contato.
# Funciona com Gmail, Outlook, Zoho, SendGrid, etc.
# No Gmail, use uma "senha de app" (não a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# E-mail que recebe as mensagens do formulário (o consultório)
CONTACT_TO_EMAIL=contato@seudominio.com.br
